# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Custom SMTP Relay Configuration (Optional server-side defaults)
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="admin@yourdomain.com"
SMTP_PASS="your_secure_password"
SMTP_FROM="Site Intelligence <admin@yourdomain.com>"


# ---------------------------------------------------------------------------
# Google Analytics 4 + Google Search Console (server-side only; never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# OAuth 2.0 "Web application" client from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID="1234567890-abc123.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Must exactly match an Authorized redirect URI on the OAuth client.
# If omitted, defaults to APP_URL + /api/google/oauth/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"
# Encrypts the httpOnly cookie that stores the visitor's Google tokens.
# Use a long random string (e.g. openssl rand -hex 32). Falls back to GOOGLE_CLIENT_SECRET.
GOOGLE_TOKEN_SECRET="replace_with_a_long_random_string"

# Optional: server-wide OAuth connection (a refresh token issued for the client above).
# GOOGLE_REFRESH_TOKEN=""

# Optional: service account instead of (or in addition to) OAuth.
# Add the service account email as a Viewer on the GA4 property and as a user on the
# Search Console property. Provide EITHER the full JSON key file contents:
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# OR the email + private key. A one-line key with literal \n sequences is fine;
# they are converted to real newlines at runtime.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="site-intel@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Default GA4 property (numeric Property ID, not the G- measurement ID) and Search Console property.
GA4_PROPERTY_ID="123456789"
# URL-prefix property (with trailing slash) or domain property, e.g. sc-domain:example.com
GSC_SITE_URL="https://www.example.com/"
